{
  "manifest_version": 3,
  "name": "Hydra Blocker",
  "version": "1.0.2",
  "description": "Ultra-lightweight, telemetry-free, premium ad blocker for Twitch using dynamic stream swapping.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hydra Blocker"
  },
  "icons": {
    "128": "assets/icons/hydra/active/icon128.png",
    "16": "assets/icons/hydra/active/icon16.png",
    "32": "assets/icons/hydra/active/icon32.png",
    "48": "assets/icons/hydra/active/icon48.png"
  }
}
